# Copy this file to assets/.env and set your LiveKit Cloud token server ID
# (Project Settings -> Development token server) to connect the app to Jarvis.
# The app fetches the wss:// LiveKit server URL from this HTTPS token endpoint.
LIVEKIT_SANDBOX_ID=''
LIVEKIT_AGENT_NAME='my-agent'

# Optional: override with your own HTTPS participant-token endpoint.
# LIVEKIT_TOKEN_ENDPOINT='https://your-server.example.com/getToken'
